<UserControl x:Class="WirelessScanner.Presentation.ConnectionDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WirelessScanner.Presentation"
             AutomationProperties.Name="Connection test controls">
    <!-- Connection test drawer in Live Survey (DR-0014). DataContext = ConnectionTestViewModel.
         Same three steps as the saturation test; WHAT is the current connection (fixed, not chosen from the list). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/HudTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource HudPanel}">
        <Grid>
            <!-- ===================== SETUP ===================== -->
            <DockPanel Visibility="{Binding IsSetup, Converter={StaticResource HudVis}}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="CONNECTION TEST" Style="{StaticResource HudTitle}" FontSize="14"/>
                    <Expander Header="What this test does" Foreground="#AA4400" Margin="0,0,0,6">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding Source={x:Static local:ConnectionTestViewModel.WhatItDoes}}" Foreground="#FF8800" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Style="{StaticResource HudHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Saturation test = listens to the radio (sends nothing). Connection test = small probes over your connection (about 12 kbit/s), bound to Wi-Fi. Targets and the data rate are printed on every report."/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SummaryLine}" Foreground="#FF8800" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF5A4A" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding HasValidationMessage, Converter={StaticResource HudVis}}"/>
                    <Button Style="{StaticResource Big}" Content="▶  START CONNECTION TEST" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                            AutomationProperties.Name="Start connection test"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Grid>
                            <TextBlock Text="1 · WHAT (your current connection)" Style="{StaticResource HudLabel}" FontWeight="Bold"/>
                            <Button Content="↻" HorizontalAlignment="Right" Padding="6,0" Command="{Binding RefreshContextCommand}" ToolTip="Read the connection again"
                                    AutomationProperties.Name="Refresh connection"/>
                        </Grid>
                        <Border Background="#0F0600" BorderBrush="#331800" BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <StackPanel>
                                <TextBlock Text="{Binding ContextText}" Foreground="#FF8800" TextWrapping="Wrap" AutomationProperties.Name="Connection under test"/>
                                <TextBlock Text="{Binding ContextWarning}" Foreground="#FAB219" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                                           Visibility="{Binding HasContextWarning, Converter={StaticResource HudVis}}"/>
                                <TextBlock Style="{StaticResource HudHint}" Margin="0,3,0,0" Text="Not chosen from the network list: the test always uses the network this PC is on."/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Parts of the path" Style="{StaticResource HudLabel}" Margin="0,8,0,2"/>
                        <WrapPanel>
                            <CheckBox Content="Wi-Fi link" IsChecked="{Binding ProbeWifiLink}" Foreground="#FF8800" Margin="0,0,10,2" ToolTip="Signal, PHY rate, frame retries, roams"/>
                            <CheckBox Content="Router" IsChecked="{Binding ProbeGateway}" Foreground="#FF8800" Margin="0,0,10,2" ToolTip="Default gateway, every second"/>
                            <CheckBox Content="ISP" IsChecked="{Binding ProbeIsp}" Foreground="#FF8800" Margin="0,0,10,2" ToolTip="First hop beyond the router (found at start)"/>
                            <CheckBox Content="Internet" IsChecked="{Binding ProbeInternet}" Foreground="#FF8800" Margin="0,0,10,2" ToolTip="Public targets, TCP 443 + ICMP"/>
                            <CheckBox Content="DNS" IsChecked="{Binding ProbeDns}" Foreground="#FF8800" Margin="0,0,10,2" ToolTip="Your configured resolvers"/>
                            <CheckBox Content="Web" IsChecked="{Binding ProbeWeb}" Foreground="#FF8800" Margin="0,0,10,2" ToolTip="Small HTTPS request every 30 s"/>
                        </WrapPanel>
                        <Expander Header="Targets" Foreground="#AA4400" Margin="0,4,0,0">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource HudLabel}" Text="Internet targets (IPv4; default Cloudflare, Google, Quad9)"/>
                                <TextBox Text="{Binding InternetTargetsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Internet targets"/>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="2 · HOW LONG" Style="{StaticResource HudLabel}" FontWeight="Bold" Margin="0,12,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}" AutomationProperties.Name="Connection test duration"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding IntensityOptions}" SelectedItem="{Binding Intensity}" AutomationProperties.Name="Probe intensity"
                                      ToolTip="Light: router every 1 s, internet every 2 s (about 12 kbit/s). Detailed: twice as often."/>
                        </Grid>
                        <StackPanel Visibility="{Binding IsCustomDuration, Converter={StaticResource HudVis}}">
                            <TextBlock Style="{StaticResource HudLabel}" Text="Custom duration (minutes, 1–1440)"/>
                            <TextBox Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom connection test minutes"/>
                        </StackPanel>

                        <TextBlock Text="3 · WHERE (shared with the saturation test)" Style="{StaticResource HudLabel}" FontWeight="Bold" Margin="0,12,0,2"/>
                        <TextBlock Style="{StaticResource HudLabel}" Text="Test area / location (required)"/>
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Connection test location"/>
                        <TextBlock Style="{StaticResource HudLabel}" Text="Latitude / longitude (decimal degrees, optional)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" ToolTip="Latitude (decimal degrees)" AutomationProperties.Name="Latitude"/>
                            <TextBox Grid.Column="2" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" ToolTip="Longitude (decimal degrees)" AutomationProperties.Name="Longitude"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HudLabel}" Text="Building / floor / zone"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Building}" ToolTip="Building" AutomationProperties.Name="Building"/>
                            <TextBox Grid.Column="2" Text="{Binding Floor}" ToolTip="Floor" AutomationProperties.Name="Floor"/>
                            <TextBox Grid.Column="4" Text="{Binding Zone}" ToolTip="Zone / room" AutomationProperties.Name="Zone"/>
                        </Grid>
                        <Expander Header="Report details (name, facility, operator, client, notes)" Foreground="#AA4400" Margin="0,8,0,0">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource HudLabel}" Text="Test name (optional)"/>
                                <TextBox Text="{Binding TestName}" AutomationProperties.Name="Connection test name"/>
                                <TextBlock Style="{StaticResource HudLabel}" Text="Facility / operator / client"/>
                                <TextBox Text="{Binding Facility}" AutomationProperties.Name="Facility"/>
                                <TextBox Text="{Binding Operator}" Margin="0,3,0,0" AutomationProperties.Name="Operator"/>
                                <TextBox Text="{Binding Client}" Margin="0,3,0,0" AutomationProperties.Name="Client"/>
                                <TextBlock Style="{StaticResource HudLabel}" Text="Notes"/>
                                <TextBox Text="{Binding Notes}" Height="40" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Notes"/>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="OPTIONS" Style="{StaticResource HudLabel}" FontWeight="Bold" Margin="0,12,0,2"/>
                        <CheckBox Content="Also run a saturation test of this access point (one timeline)" IsChecked="{Binding AlsoSaturation}" Foreground="#FF8800" Margin="0,0,0,3"
                                  ToolTip="Starts a saturation test of the connected access point (all its SSIDs and radios) at the same time"/>
                        <CheckBox Content="Stop if the PC moves to another network" IsChecked="{Binding StopOnNetworkChange}" Foreground="#FF8800" Margin="0,0,0,3"
                                  ToolTip="Roams within the same network are always recorded as events"/>
                        <CheckBox Content="Keep this PC awake while the test runs" IsChecked="{Binding KeepAwakeEnabled}" Foreground="#FF8800" Margin="0,0,0,3"/>

                        <Expander Header="Speed and responsiveness (stage B)" Foreground="#AA4400" Margin="0,8,0,0">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding SpeedHint}" Style="{StaticResource HudHint}" TextWrapping="Wrap"/>
                                <CheckBox Content="Run a speed test at the start" IsChecked="{Binding SpeedAtStart}" IsEnabled="{Binding HasSpeedServer}" Foreground="#FF8800" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Repeat every" Foreground="#AA4400" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox Width="90" ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SpeedEveryMinutes}" ItemStringFormat="{}{0} min"
                                              IsEnabled="{Binding HasSpeedServer}" AutomationProperties.Name="Speed test schedule" ToolTip="0 = not repeated"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Two-way Wi-Fi test with a LAN responder (stage C)" Foreground="#AA4400" Margin="0,6,0,0">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding TwoWayHint}" Style="{StaticResource HudHint}" TextWrapping="Wrap"/>
                                <CheckBox Content="Run a two-way test at the start" IsChecked="{Binding TwoWayAtStart}" IsEnabled="{Binding HasResponder}" Foreground="#FF8800" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Repeat every" Foreground="#AA4400" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox Width="90" ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding TwoWayEveryMinutes}" ItemStringFormat="{}{0} min"
                                              IsEnabled="{Binding HasResponder}" AutomationProperties.Name="Two-way test schedule" ToolTip="0 = not repeated"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ===================== RUNNING ===================== -->
            <DockPanel Visibility="{Binding IsRunningStep, Converter={StaticResource HudVis}}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding RunStatus}" FontSize="14" FontWeight="Bold" Foreground="#FF6600" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding ProgressPct, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="12" Margin="0,8,0,6"
                                 Foreground="#FF6600" Background="#1A0A00" BorderBrush="#883300" AutomationProperties.Name="Connection test progress"/>
                    <TextBlock Foreground="#AA4400">
                        <Run Text="Elapsed "/><Run Text="{Binding ElapsedText, Mode=OneWay}" Foreground="#FF8800" FontWeight="Bold"/>
                        <Run Text="   Remaining "/><Run Text="{Binding RemainingText, Mode=OneWay}" Foreground="#FF8800" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ActivityText}" Foreground="#FAB219" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasActivity, Converter={StaticResource HudVis}}"/>
                    <TextBlock Text="{Binding WarningText}" Foreground="#FAB219" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasWarning, Converter={StaticResource HudVis}}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Big}" Content="❚❚  PAUSE" Command="{Binding PauseCommand}" Visibility="{Binding IsNotPaused, Converter={StaticResource HudVis}}" AutomationProperties.Name="Pause connection test"/>
                        <Button Style="{StaticResource Big}" Content="▶  RESUME" Command="{Binding ResumeCommand}" Visibility="{Binding IsPaused, Converter={StaticResource HudVis}}" AutomationProperties.Name="Resume connection test"/>
                        <Button Grid.Column="2" Style="{StaticResource Big}" Content="■  STOP" Command="{Binding StopCommand}" AutomationProperties.Name="Stop connection test"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="SPEED TEST NOW" Command="{Binding RunSpeedNowCommand}" IsEnabled="{Binding HasSpeedServer}" Padding="6,5"
                                ToolTip="Download and upload capacity plus latency under load (saturates the link briefly)" AutomationProperties.Name="Run speed test now"/>
                        <Button Grid.Column="2" Content="TWO-WAY TEST NOW" Command="{Binding RunTwoWayNowCommand}" IsEnabled="{Binding HasResponder}" Padding="6,5"
                                ToolTip="Per-direction loss, jitter and LAN capacity against the paired responder" AutomationProperties.Name="Run two-way test now"/>
                    </Grid>
                    <TextBlock Text="{Binding ActionStatus}" Foreground="#FF8800" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="ADD MARKER" Style="{StaticResource HudTitle}" Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding MarkerText, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. microwave on, streaming started, moved to desk" AutomationProperties.Name="Marker text"/>
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddMarkerCommand}" Margin="6,0,0,0" Padding="12,4"/>
                    </Grid>
                    <TextBlock Text="EVENT FEED" Style="{StaticResource HudTitle}" Margin="0,12,0,4"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding EventFeed}" Background="#000000" Foreground="#FF8800" BorderBrush="#883300" FontFamily="Consolas" FontSize="11"
                         AutomationProperties.Name="Connection event feed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ===================== RESULTS ===================== -->
            <StackPanel Visibility="{Binding IsResults, Converter={StaticResource HudVis}}">
                <TextBlock Text="RESULTS" Style="{StaticResource HudTitle}" FontSize="14"/>
                <TextBlock Text="{Binding ResultTitle}" Foreground="#AA4400" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Style="{StaticResource Big}" Content="PDF REPORT" Command="{Binding ExportPdfCommand}" Margin="0,0,0,6" AutomationProperties.Name="Export connection PDF"/>
                <Button Style="{StaticResource Big}" Content="CSV BUNDLE" Command="{Binding ExportCsvCommand}" Margin="0,0,0,6" AutomationProperties.Name="Export connection CSV"/>
                <Button Style="{StaticResource Big}" Content="JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,0,14" AutomationProperties.Name="Export connection JSON"/>
                <Button Style="{StaticResource Big}" Content="NEW TEST" Command="{Binding NewTestCommand}" AutomationProperties.Name="New connection test"/>
                <TextBlock Text="{Binding ExportStatus}" Foreground="#FF8800" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
