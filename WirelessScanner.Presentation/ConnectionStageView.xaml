<UserControl x:Class="WirelessScanner.Presentation.ConnectionStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Connection test view">
    <!-- Centre stage of the connection test (DR-0014). DataContext = ConnectionTestViewModel.
         Running: connection path strip + stacked timelines (one axis each). Results: verdicts, where problems happened, segments,
         timelines, speed / two-way results, events. Status words always accompany colour. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/HudTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <DataTemplate x:Key="TileTemplate">
                <Border BorderBrush="{Binding Brush}" BorderThickness="2" CornerRadius="6" Padding="8,6" Margin="0,0,6,6" ToolTip="{Binding ToolTipText}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="#FF8800" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Status}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Line1}" Foreground="#FF8800" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Line2}" Foreground="#AA4400" FontSize="11"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- SETUP -->
        <Border Style="{StaticResource HudPanel}" Visibility="{Binding IsSetup, Converter={StaticResource HudVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="CONNECTION TEST" Style="{StaticResource HudTitle}" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource HudHint}" TextAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Text="Checks the connection this PC is on, from the Wi-Fi link to the router, the ISP and the internet (plus DNS and a small web request), and shows where any problem happens. Fill in how long and where at right, then press START. The connection is never changed."/>
                <TextBlock Style="{StaticResource HudHint}" TextAlignment="Center" FontSize="12" Margin="0,10,0,0"
                           Text="Wi-Fi link  →  Router  →  ISP  →  Internet      ·      DNS      ·      Web"/>
            </StackPanel>
        </Border>

        <!-- RUNNING -->
        <Grid Visibility="{Binding IsRunningStep, Converter={StaticResource HudVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="CONNECTION PATH · where a problem happens" Style="{StaticResource HudTitle}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" AutomationProperties.Name="Connection path">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource HudPanel}" Padding="8" Margin="0,4,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Round trip per segment (ms, red ticks = failed probes) and Wi-Fi signal (dBm), one time axis, each panel with its own scale"
                               Style="{StaticResource HudHint}"/>
                    <Canvas Grid.Row="1" x:Name="LiveChart" ClipToBounds="True" SizeChanged="OnChartSizeChanged" Margin="0,6,0,0" Background="Transparent"
                            AutomationProperties.Name="Connection timeline"/>
                </Grid>
            </Border>
        </Grid>

        <!-- RESULTS -->
        <ScrollViewer Visibility="{Binding IsResults, Converter={StaticResource HudVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="CONNECTION TEST RESULTS" Style="{StaticResource HudTitle}" FontSize="14"/>
                <TextBlock Text="{Binding ResultTitle}" Foreground="#AA4400" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding ResultVerdicts}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AutomationProperties.Name="Verdicts by use">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="USE" Binding="{Binding Use}" Width="130"/>
                        <DataGridTextColumn Header="RATING" Binding="{Binding Rating}" Width="90"/>
                        <DataGridTextColumn Header="WHY" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding ProblemsText}" Foreground="#FF8800" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,2" AutomationProperties.Name="Where problems happened"/>
                <TextBlock Text="{Binding VoiceText}" Foreground="#AA4400" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="SEGMENTS" Style="{StaticResource HudTitle}"/>
                <DataGrid ItemsSource="{Binding ResultSegments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AutomationProperties.Name="Segment statistics">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SEGMENT" Binding="{Binding Segment}" Width="80"/>
                        <DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="*"/>
                        <DataGridTextColumn Header="SENT" Binding="{Binding Sent}" Width="55"/>
                        <DataGridTextColumn Header="LOSS %" Binding="{Binding LossPct, StringFormat=0.##}" Width="60"/>
                        <DataGridTextColumn Header="AVAIL %" Binding="{Binding AvailabilityPct, StringFormat=0.##}" Width="62"/>
                        <DataGridTextColumn Header="P50 ms" Binding="{Binding RttP50, StringFormat=0.0}" Width="58"/>
                        <DataGridTextColumn Header="P95 ms" Binding="{Binding RttP95, StringFormat=0.0}" Width="58"/>
                        <DataGridTextColumn Header="JITTER" Binding="{Binding JitterMs, StringFormat=0.0}" Width="58"/>
                        <DataGridTextColumn Header="OUTAGES" Binding="{Binding Outages}" Width="68"/>
                        <DataGridTextColumn Header="SPIKES" Binding="{Binding Spikes}" Width="56"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Canvas x:Name="ResultChart" Height="320" ClipToBounds="True" SizeChanged="OnChartSizeChanged" Margin="0,8,0,8" Background="Transparent"
                        AutomationProperties.Name="Connection timeline (results)"/>
                <TextBlock Text="SPEED AND RESPONSIVENESS" Style="{StaticResource HudTitle}"/>
                <DataGrid ItemsSource="{Binding ResultSpeed}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="40" AutomationProperties.Name="Speed tests">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding StartUtc, StringFormat=HH:mm:ss}" Width="80"/>
                        <DataGridTextColumn Header="DOWN Mbps" Binding="{Binding DownloadMbps, StringFormat=0.0}" Width="80"/>
                        <DataGridTextColumn Header="UP Mbps" Binding="{Binding UploadMbps, StringFormat=0.0}" Width="70"/>
                        <DataGridTextColumn Header="+ms LOADED" Binding="{Binding LatencyIncreaseMs, StringFormat=0}" Width="80"/>
                        <DataGridTextColumn Header="GRADE" Binding="{Binding BufferbloatGrade}" Width="55"/>
                        <DataGridTextColumn Header="SERVER" Binding="{Binding Server}" Width="*"/>
                        <DataGridTextColumn Header="ERROR" Binding="{Binding Error}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="TWO-WAY WI-FI (LAN RESPONDER)" Style="{StaticResource HudTitle}" Margin="0,8,0,0"/>
                <DataGrid ItemsSource="{Binding ResultTwoWay}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="40" AutomationProperties.Name="Two-way tests">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding StartUtc, StringFormat=HH:mm:ss}" Width="80"/>
                        <DataGridTextColumn Header="LOSS UP %" Binding="{Binding UpLossPct, StringFormat=0.##}" Width="75"/>
                        <DataGridTextColumn Header="LOSS DOWN %" Binding="{Binding DownLossPct, StringFormat=0.##}" Width="90"/>
                        <DataGridTextColumn Header="JITTER UP" Binding="{Binding UpJitterMs, StringFormat=0.00}" Width="72"/>
                        <DataGridTextColumn Header="JITTER DOWN" Binding="{Binding DownJitterMs, StringFormat=0.00}" Width="85"/>
                        <DataGridTextColumn Header="MOS UP/DOWN (EST.)" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0:0.00} / {1:0.00}">
                                    <Binding Path="MosUp"/>
                                    <Binding Path="MosDown"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="LAN Mbps DOWN" Binding="{Binding LanDownMbps, StringFormat=0.0}" Width="95"/>
                        <DataGridTextColumn Header="ERROR" Binding="{Binding Error}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="EVENTS" Style="{StaticResource HudTitle}" Margin="0,8,0,0"/>
                <DataGrid ItemsSource="{Binding ResultEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="260" AutomationProperties.Name="Connection events">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="START (UTC)" Binding="{Binding StartUtc, StringFormat=HH:mm:ss}" Width="80"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="95"/>
                        <DataGridTextColumn Header="WHERE" Binding="{Binding AttributedTo}" Width="80"/>
                        <DataGridTextColumn Header="DUR. s" Binding="{Binding DurationSeconds, StringFormat=0.0}" Width="55"/>
                        <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
