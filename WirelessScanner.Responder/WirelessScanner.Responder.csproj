<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console host for the LAN responder (DR-0014 stage C). Runs on any wired machine with .NET 10, or self-contained:
       dotnet publish WirelessScanner.Responder -c Release -r linux-arm64 (self-contained)   (Raspberry Pi)
       dotnet publish WirelessScanner.Responder -c Release -r win-x64 (self-contained)       (Windows PC) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WirelessScanner.Responder</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WirelessScanner.Responder.Core\WirelessScanner.Responder.Core.csproj" />
  </ItemGroup>

</Project>
