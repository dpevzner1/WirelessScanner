<Window x:Class="WirelessScanner.Presentation.EndOfCaptureExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Complete — Export Data" Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#000000" Foreground="#FF6600"
        WindowStyle="None" AllowsTransparency="True">

    <Border CornerRadius="12" BorderBrush="#FF6600" BorderThickness="2" Background="#000000">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title -->
                <RowDefinition Height="Auto"/>  <!-- Session Summary -->
                <RowDefinition Height="*"/>     <!-- Export Buttons -->
                <RowDefinition Height="Auto"/>  <!-- Skip -->
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="✓ SESSION CAPTURE COMPLETE" FontSize="18" FontWeight="Bold" Foreground="#FF6600"/>
                <TextBlock Text="Export the captured telemetry data now, or skip to export later from History / Logs." 
                           Foreground="#AA4400" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- SESSION SUMMARY -->
            <Border Grid.Row="1" BorderBrush="#883300" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18" Background="#050200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Session:" Foreground="#883300" FontWeight="Bold" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSessionName" Text="" Foreground="#FF8800" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Duration:" Foreground="#883300" FontWeight="Bold" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDuration" Text="" Foreground="#FF8800"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Facility:" Foreground="#883300" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtFacility" Text="" Foreground="#FF8800"/>
                </Grid>
            </Border>

            <!-- EXPORT BUTTONS -->
            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="EXPORT CSV" Click="OnExportCsv" Margin="0,0,6,0" Height="44"
                        Background="#000000" Foreground="#FF6600" BorderBrush="#FF6600" BorderThickness="1" FontWeight="Bold" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="1" Content="EXPORT JSON" Click="OnExportJson" Margin="6,0,6,0" Height="44"
                        Background="#000000" Foreground="#FF6600" BorderBrush="#FF6600" BorderThickness="1" FontWeight="Bold" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="EXPORT PDF" Click="OnExportPdf" Margin="6,0,0,0" Height="44"
                        Background="#000000" Foreground="#FF6600" BorderBrush="#FF6600" BorderThickness="1" FontWeight="Bold" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- SKIP -->
            <Button Grid.Row="3" Content="SKIP" Click="OnSkip" HorizontalAlignment="Center" Height="36" Width="140"
                    Background="#000000" Foreground="#883300" BorderBrush="#883300" BorderThickness="1" FontWeight="Bold" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
