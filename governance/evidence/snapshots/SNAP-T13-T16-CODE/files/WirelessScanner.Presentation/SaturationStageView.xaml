<UserControl x:Class="WirelessScanner.Presentation.SaturationStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Saturation test view">
    <!-- Centre stage of the saturation test (DR-0011). DataContext = SaturationTestViewModel.
         Running: live tiles + timeline. Results: per-target table, timeline of the selected target, events.
         Status always carries a text label as well as colour (SAT-AC-09). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/HudTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- compact tables: the stage shares the width with the explorer and the drawer -->
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="Padding" Value="6,3"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- SETUP: nothing to show yet -->
        <Border Style="{StaticResource HudPanel}" Visibility="{Binding IsSetup, Converter={StaticResource HudVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Text="SATURATION TEST" Style="{StaticResource HudTitle}" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource HudHint}" TextAlignment="Center" FontSize="12"
                           Text="Choose the networks in the list at left, fill in how long and where in the panel at right, then press START. Live tiles and the signal timeline appear here while the test runs; results open here when it ends."/>
            </StackPanel>
        </Border>

        <!-- RUNNING -->
        <Grid Visibility="{Binding IsRunningStep, Converter={StaticResource HudVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,8" MaxHeight="240" AutomationProperties.Name="Live target tiles">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding Brush}" BorderThickness="2" CornerRadius="6" Padding="10" Margin="0,0,8,8" Width="320">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="#FF8800" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding Current}" FontSize="28" FontWeight="Bold" Foreground="{Binding Brush}"/>
                                    <TextBlock Text="{Binding CurrentLabel}" FontSize="13" FontWeight="Bold" Foreground="{Binding Brush}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Stats}" Foreground="#AA4400" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Events}" Foreground="#FF8800" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Row="1" Style="{StaticResource HudPanel}" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HudHint}" Text="Live signal timeline (bands: &lt;-67 / &lt;-70 / &lt;-80 dBm · red ticks = not seen · dashed = markers)"/>
                    <Canvas Grid.Row="1" x:Name="LiveChart" ClipToBounds="True" SizeChanged="OnChartSizeChanged" AutomationProperties.Name="Live RSSI timeline"/>
                </Grid>
            </Border>
        </Grid>

        <!-- RESULTS -->
        <Grid Visibility="{Binding IsResults, Converter={StaticResource HudVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding ResultTargets}" SelectedItem="{Binding SelectedResultTarget}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" MaxHeight="170" HorizontalScrollBarVisibility="Auto" FontSize="11.5" Margin="0,0,0,8" AutomationProperties.Name="Target summaries">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="GRADE" Binding="{Binding Grade}" Width="Auto"/>
                    <DataGridTextColumn Header="SCORE" Binding="{Binding StabilityScore, StringFormat=F1}" Width="Auto"/>
                    <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="Auto"/>
                    <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="Auto"/>
                    <DataGridTextColumn Header="CH" Binding="{Binding Channels}" Width="Auto"/>
                    <DataGridTextColumn Header="AVAIL %" Binding="{Binding AvailabilityPct, StringFormat=F1}" Width="Auto"/>
                    <DataGridTextColumn Header="MEAN" Binding="{Binding Mean, StringFormat=F1}" Width="Auto"/>
                    <DataGridTextColumn Header="TIER" Binding="{Binding Tier}" Width="Auto"/>
                    <DataGridTextColumn Header="σ dB" Binding="{Binding StdDev, StringFormat=F1}" Width="Auto"/>
                    <DataGridTextColumn Header="MIN" Binding="{Binding Min}" Width="Auto"/>
                    <DataGridTextColumn Header="MAX" Binding="{Binding Max}" Width="Auto"/>
                    <DataGridTextColumn Header="DROPS" Binding="{Binding DropCount}" Width="Auto"/>
                    <DataGridTextColumn Header="DROPOUTS" Binding="{Binding DropoutCount}" Width="Auto"/>
                    <DataGridTextColumn Header="CH CHG" Binding="{Binding ChannelChangeCount}" Width="Auto"/>
                    <DataGridTextColumn Header="%&lt;-80" Binding="{Binding PctBelowUnusable, StringFormat=F1}" Width="Auto"/>
                    <DataGridTextColumn Header="FINDINGS" Binding="{Binding Findings[0]}" Width="*" MinWidth="220"/>
                </DataGrid.Columns>
            </DataGrid>
                <Border Grid.Row="1" Style="{StaticResource HudPanel}" Padding="6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Selected target timeline (bands: &lt;-67 / &lt;-70 / &lt;-80 dBm · red ticks = not seen · dashed = markers)" Style="{StaticResource HudHint}"/>
                        <Canvas Grid.Row="1" x:Name="ResultChart" ClipToBounds="True" SizeChanged="OnChartSizeChanged" AutomationProperties.Name="Result RSSI timeline"/>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="2" ItemsSource="{Binding ResultEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="11.5" HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Detected events">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="Auto"/>
                        <DataGridTextColumn Header="START (UTC)" Binding="{Binding StartUtc, StringFormat=HH:mm:ss}" Width="Auto"/>
                        <DataGridTextColumn Header="DUR s" Binding="{Binding DurationSeconds, StringFormat=F0}" Width="Auto"/>
                        <DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="Auto"/>
                        <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*" MinWidth="240"/>
                    </DataGrid.Columns>
                </DataGrid>
        </Grid>
    </Grid>
</UserControl>

