<Project Sdk="Microsoft.NET.Sdk">

  <!-- DR-0007: .NET Framework 4.8 is part of Windows 10/11, so the installer has no runtime prerequisite. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WirelessScanner.Setup</AssemblyName>
    <RootNamespace>WirelessScanner.Setup</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WirelessScanner.Setup.Core\WirelessScanner.Setup.Core.csproj" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
