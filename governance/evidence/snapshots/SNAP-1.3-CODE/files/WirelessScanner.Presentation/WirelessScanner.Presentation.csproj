<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WirelessScanner.Domain\WirelessScanner.Domain.csproj" />
    <ProjectReference Include="..\WirelessScanner.Application\WirelessScanner.Application.csproj" />
    <ProjectReference Include="..\WirelessScanner.Infrastructure\WirelessScanner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Product>WirelessScanner</Product>
    <!-- Complete version resources: shown in Explorer > Properties > Details, and sparse PE metadata is a known
         heuristic trigger for antivirus machine-learning engines (Malwarebytes flagged the 1.3 dev build, 2026-10-16). -->
    <Company>Demitri Pevzner</Company>
    <Authors>Demitri Pevzner</Authors>
    <AssemblyTitle>WirelessScanner</AssemblyTitle>
    <Description>WirelessScanner - Wi-Fi signal analysis, site survey and signal saturation testing for Windows</Description>
    <Copyright>Copyright (c) 2026 Demitri Pevzner. MIT licence.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://github.com/dpevzner1/WirelessScanner</RepositoryUrl>
    <!-- Embedded in the .exe: Apps & features (DisplayIcon exe,0), shortcuts, taskbar and Explorer all read it from here.
         Generated by tools/make_icons.py from branding/ (one source for Windows and the future Android port). -->
    <!-- ApplicationIcon (Assets\WirelessScanner.ico) is ON HOLD: Malwarebytes real-time ML flags this build as MachineLearning/Anomalous.93% and quarantines it whenever the icon is embedded (2026-10-16, 9 detections; owner decision pending: exclusion / code signing). Re-enable with tools/make_icons.py assets once resolved. -->
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="WirelessScanner.Tests" />
  </ItemGroup>

  <!-- Never ship native debug symbols (an 84 MB libSkiaSharp.pdb came from a package; finding F11). -->
  <Target Name="RemovePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
